# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# Atlas connection strings. The database name must be in the path.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/dws_dev?retryWrites=true&w=majority"
DATABASE_URL_TEST="mongodb+srv://<user>:<password>@<cluster-host>/dws_test?retryWrites=true&w=majority"

# Stand-in for officer auth: any random string of 16+ characters (openssl rand -hex 24).
OFFICER_API_KEY="<long-random-string>"

CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"
