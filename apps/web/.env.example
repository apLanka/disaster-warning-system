# Copy to .env.local. Never commit real values.
VITE_API_BASE_URL=http://localhost:3000

# Stand-in for officer login (out of scope). Must equal OFFICER_API_KEY in apps/api/.env.
# It ends up in the built JavaScript, so it is not a secret: do not reuse a real credential.
VITE_OFFICER_KEY=

VITE_OFFICER_NAME=Duty Officer
