{
  "name": "disaster-warning-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.2.20"
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "unrs-resolver"
  ]
}
